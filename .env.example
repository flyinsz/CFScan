# 复制为 .env 后填写；.env 含密钥，禁止提交到仓库。
# ---------- Web 界面 ----------
WEB_ENABLED=true
WEB_PORT=13335
# 可选：留空则 Web 无认证（建议仅内网访问）
WEB_USER=
WEB_PASS=

# ---------- 定时任务 ----------
AUTO_ENABLED=true
# 间隔模式：6h / 30m；AUTO_AT 非空时改为每天固定时刻（按 TZ）
AUTO_INTERVAL=6h
AUTO_AT=
# 容器启动立即跑一次，便于验证；稳定后可设 false
AUTO_RUN_ON_START=true
# 单次模式：跑完一次即退出（用于 docker exec 手动触发验证）
AUTO_RUN_ONCE=false

# ---------- 优选参数 ----------
SCAN_MODE=official
SCAN_IPTYPE=4
SCAN_PORT=443
SCAN_THREADS=100
SCAN_DELAY=300
SCAN_SPEED_LIMIT=10
SCAN_SPEED_MIN=1
SCAN_ROWS=20
SCAN_TIMEOUT=45m
# 端到端验证：跳过真实扫描，用 SCAN_TEST_IPS 走完上报链路
SCAN_DRY_RUN=false
SCAN_TEST_IPS=

# ---------- CFNext 上报 ----------
# auto=面板优先失败回退 KV；kv=只走 Cloudflare KV API；panel=只走面板；dry=不写入
CFNEXT_CHANNEL=auto
CFNEXT_MAX_IPS=100
# 写入时把 subMode 设为 custom（自定义订阅）
CFNEXT_SET_SUBMODE=true
HTTP_TIMEOUT=30s

# Cloudflare KV 通道
CF_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=
CF_API_TOKEN=

# 面板 HTTP 通道（登录入口，不是 API 路径）
CFNEXT_PANEL_URL=https://cfn.vipchanel.com/donny-admin
CFNEXT_PASSWORD=
# CFNext 3.x 的 API 基址：留空则从控制台 APIPATH 自动发现 /<uuid>
CFNEXT_API_BASE=
# 前后端分离版后端密钥（如有）
CFNEXT_API_KEY=

# ---------- Web 面板：🚀 定时自动优选与上报 ----------
# 以上定时 / 扫描 / 上报参数均可在 Web UI 顶部 🚀 按钮中修改并保存。
# 保存后写入 /data/auto-config.json（密码与 Token 用 AES-GCM 加密），
# 调度器 2 秒内热加载，无需重启容器。面板内还有「测试连接」「立即运行一次」。
